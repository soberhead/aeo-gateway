# Kopiere diese Datei in eine neue Datei namens '.env' und trage deine echten Keys ein.

# Gemini API Key für die echte Agenten-Simulation (run_real_agent.py)
GEMINI_API_KEY=DEIN_API_KEY_HIER

# Dashboard-Zugangsdaten (admin / AeoSpaceport2026Secure ist der Default)
AEO_ADMIN_USER=admin
AEO_ADMIN_PASSWORD=AeoSpaceport2026Secure

# Dashboard-Konfiguration
AEO_DASHBOARD_LOCAL_ONLY=false
AEO_ENABLE_DASHBOARD=true
